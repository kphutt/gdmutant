#!/bin/sh
# Runs a dev command through mise's pinned toolchain if mise is installed, otherwise runs it
# directly. CONTRIBUTING.md documents both paths as supported ("Prefer not to use mise? Install
# uv yourself") -- this is what lets the same pre-commit hooks work for either audience instead of
# hard-requiring `mise exec --` (found live via Litmus review: a no-mise contributor got
# "mise: command not found" on every pre-push hook).
set -eu

if command -v mise >/dev/null 2>&1; then
  exec mise exec -- "$@"
else
  exec "$@"
fi
